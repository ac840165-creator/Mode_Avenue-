# Database Type Configuration
# Options: 'sqlite' (default, uses pre-populated local file) or 'mysql'
DB_TYPE=sqlite

# MySQL Database Configuration (only used if DB_TYPE=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mode_avenue_db

# Flask Configuration
SECRET_KEY=your-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=True

